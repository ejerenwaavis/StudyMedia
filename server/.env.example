# StudyMedia Server Environment Configuration
# Copy to root `.env` (both locally and on Namecheap `/home/acedzagz/studymedia/.env`)

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (database: studymedia)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studymedia?retryWrites=true&w=majority

# Invite-Only Authentication (v3.0)
# Generate a strong JWT secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INVITE_CODE=replace_with_private_invite_code
JWT_SECRET=replace_with_long_random_jwt_secret
ADMIN_EMAIL=your-admin-email@example.com

# Cloudflare R2 Cloud Vault (S3-Compatible Presigned URLs)
# Create an R2 API Token with "Object Read & Write" permission scoped to your bucket
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=studymedia-vault

# =============================================================================
# REQUIRED CLOUDFLARE R2 BUCKET CORS POLICY
# In Cloudflare Dashboard -> R2 -> <your-bucket> -> Settings -> CORS Policy:
# [
#   {
#     "AllowedOrigins": [
#       "https://studymedia.aceddivision.com",
#       "http://localhost:5173"
#     ],
#     "AllowedMethods": ["GET", "PUT", "HEAD"],
#     "AllowedHeaders": ["Content-Type", "Content-Length", "Authorization", "x-amz-*"],
#     "ExposeHeaders": ["ETag", "Content-Length", "Content-Type"],
#     "MaxAgeSeconds": 3600
#   }
# ]
# =============================================================================
